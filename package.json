{
  "name": "triangle-screener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "COVERAGE=1 vitest run --coverage",
    "e2e": "next build && playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.5",
    "p-limit": "^7.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "lint-staged": {
    "*.{ts,tsx,mjs,css,md,json,yml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
